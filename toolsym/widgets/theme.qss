/* ToolSym unified dark theme — applied to both apps for visual consistency. */

QWidget {
    background-color: #1e1e1e;
    color: #d0d0d0;
    font-family: "Segoe UI", "Helvetica Neue", Arial, sans-serif;
    font-size: 10pt;
}

QMainWindow {
    background-color: #1a1a1a;
}

QTabWidget::pane {
    border: 1px solid #2a2a2a;
    top: -1px;
    background: #1e1e1e;
}

QTabBar::tab {
    background: #2a2a2a;
    color: #b0b0b0;
    padding: 8px 18px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background: #1e1e1e;
    color: #e0e0e0;
    border-top: 2px solid #4682c8;
}

QPushButton {
    background-color: #2d2d2d;
    color: #d0d0d0;
    border: 1px solid #3a3a3a;
    border-radius: 4px;
    padding: 6px 14px;
    min-height: 22px;
}

QPushButton:hover {
    background-color: #3a3a3a;
    border-color: #4682c8;
}

QPushButton:pressed {
    background-color: #4682c8;
    color: white;
}

QPushButton:disabled {
    background-color: #1f1f1f;
    color: #555;
    border-color: #2a2a2a;
}

QLineEdit,
QSpinBox,
QDoubleSpinBox,
QComboBox,
QTextEdit,
QPlainTextEdit {
    background-color: #161616;
    color: #d0d0d0;
    border: 1px solid #2a2a2a;
    border-radius: 3px;
    padding: 4px 6px;
    selection-background-color: #4682c8;
}

QLineEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QComboBox:focus,
QTextEdit:focus,
QPlainTextEdit:focus {
    border-color: #4682c8;
}

QComboBox::drop-down {
    border-left: 1px solid #2a2a2a;
    width: 18px;
}

QGroupBox {
    background-color: #1e1e1e;
    border: 1px solid #2a2a2a;
    border-radius: 4px;
    margin-top: 14px;
    padding-top: 14px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    color: #b0b0b0;
}

QProgressBar {
    background-color: #161616;
    border: 1px solid #2a2a2a;
    border-radius: 3px;
    text-align: center;
    color: #d0d0d0;
}

QProgressBar::chunk {
    background-color: #4682c8;
    border-radius: 2px;
}

QListWidget,
QTreeWidget,
QTableWidget {
    background-color: #161616;
    color: #d0d0d0;
    border: 1px solid #2a2a2a;
    selection-background-color: #4682c8;
    selection-color: white;
}

QListWidget::item:hover,
QTreeWidget::item:hover {
    background-color: #2a2a2a;
}

QScrollBar:vertical {
    background: #1e1e1e;
    width: 12px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #3a3a3a;
    min-height: 24px;
    border-radius: 6px;
}

QScrollBar::handle:vertical:hover {
    background: #4682c8;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: #1e1e1e;
    height: 12px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: #3a3a3a;
    min-width: 24px;
    border-radius: 6px;
}

QScrollBar::handle:horizontal:hover {
    background: #4682c8;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}

QSlider::groove:horizontal {
    background: #2a2a2a;
    height: 4px;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: #4682c8;
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 7px;
}

QMenuBar {
    background: #1a1a1a;
    color: #d0d0d0;
}

QMenuBar::item:selected,
QMenu::item:selected {
    background: #4682c8;
    color: white;
}

QMenu {
    background: #1e1e1e;
    color: #d0d0d0;
    border: 1px solid #2a2a2a;
}

QStatusBar {
    background: #161616;
    color: #888;
    border-top: 1px solid #2a2a2a;
}
