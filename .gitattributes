# Normalize line endings: always LF in repo, native on checkout for shell scripts.
* text=auto eol=lf

*.py        text eol=lf
*.pyi       text eol=lf
*.md        text eol=lf
*.toml      text eol=lf
*.cfg       text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.json      text eol=lf
*.qss       text eol=lf
*.spec      text eol=lf
*.cff       text eol=lf
*.txt       text eol=lf

# Windows-native batch files.
*.bat       text eol=crlf
*.cmd       text eol=crlf

# Binaries.
*.ico       binary
*.png       binary
*.jpg       binary
*.tif       binary
*.tiff      binary
*.npz       binary
*.pdf       binary
*.step      binary
*.STEP      binary
*.stp       binary
*.stl       binary
